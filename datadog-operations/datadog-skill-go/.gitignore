# Datadog CLI Go - .gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt
*.coverprofile

# Go workspace file
go.work

# Environment variables
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts (local development binaries)
dd
dd-*
!dd-*/
dd-optimized
/bin/dd
/bin/dd-*

# Keep release binaries in bin/ directory for distribution
!/bin/dd-darwin-amd64
!/bin/dd-darwin-arm64
!/bin/dd-linux-amd64
!/bin/dd-linux-arm64
!/bin/dd-windows-amd64.exe
!/bin/dd-windows-arm64.exe

# Dependency directories
vendor/

# Temporary files
tmp/
temp/
*.tmp

# Log files
*.log

# Debug files
debug
__debug_bin

# Profiling files
*.prof
*.pprof
cpu.prof
mem.prof

# OS generated files
Thumbs.db

# Test cache
.cache/

# Go build cache
.go-build/

# Pants build system
.pants.d/
dist/
.pids/

# Datadog credentials (never commit!)
**/DD_API_KEY
**/DD_APP_KEY
credentials.json
secrets.yml
secrets.yaml

# Local configuration
config.local.yml
config.local.yaml
*.local.toml

# Documentation build artifacts
docs/_build/
site/

# CI/CD artifacts (keep workflow definitions)
.github/artifacts/

# Claude Code
.claude/
