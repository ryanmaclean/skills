{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryanmaclean.com/schemas/ryanlab.bench.v1.schema.json",
  "title": "Ryan Lab Benchmark Record v1",
  "type": "object",
  "required": [
    "schema",
    "project",
    "timestamp",
    "workload",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "ryanlab.bench.v1"
    },
    "project": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "filesystem": {
      "type": [
        "string",
        "null"
      ]
    },
    "workload": {
      "type": "string"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "artifact_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rss_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "boot_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rename_us_p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fsync_us_p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "recovery_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "write_amplification": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "metadata_bytes_per_run": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "history_bytes_per_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lineage_reconstruction_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
