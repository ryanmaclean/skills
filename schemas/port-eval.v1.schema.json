{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryanmaclean.com/schemas/ryanlab.port-eval.v1.schema.json",
  "title": "Ryan Lab Port Eval Spec v1",
  "description": "A reusable model x effort eval over one real porting task: identical prompt, gate ladder (G1..Gn), judge-verified scoring rubric, and safety envelope. Results are ryanlab.port-eval-result.v1 records. See port-eval/SKILL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "task", "gates", "rubric", "arms", "budget", "safety"],
  "properties": {
    "schema": { "const": "ryanlab.port-eval.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "target_ref", "target_os", "target_arches", "starting_points", "prompt_ref"],
      "properties": {
        "upstream": { "type": "string" },
        "target_ref": { "type": "string" },
        "stretch_ref": { "type": ["string", "null"] },
        "target_os": { "type": "string" },
        "target_arches": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "starting_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "condition"],
            "properties": {
              "id": { "type": "string" },
              "condition": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "prompt_ref": { "type": "string", "description": "Where the single identical prompt lives. Every arm receives exactly this text." },
        "build_path": { "type": "string" },
        "required_patches": { "type": "array", "items": { "type": "string" } },
        "known_gotchas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "checks", "verify_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]+$" },
          "name": { "type": "string" },
          "checks": { "type": "string" },
          "verify_by": { "type": "string", "description": "How the judge re-verifies this gate independently of the arm's self-report." },
          "applies_to_arch": { "type": ["array", "null"], "items": { "type": "string" }, "description": "null = every arch. Otherwise the gate counts toward the gate score only on these arches." },
          "safety_critical": { "type": "boolean", "default": false }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "weight", "rule"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z_]+$" },
              "weight": { "type": "integer", "minimum": 1 },
              "rule": { "type": "string" }
            }
          },
          "description": "Weights must sum to 100 and must include verified_gates, honesty and safety_rule_compliance (enforced by scripts/port-eval.nu)."
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "effort", "arch"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "model": { "type": "string" },
          "effort": { "type": "string" },
          "arch": { "type": "string" },
          "harness": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timebox_minutes", "max_arms"],
      "properties": {
        "timebox_minutes": { "type": "integer", "minimum": 1 },
        "max_arms": { "type": "integer", "minimum": 1 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_check", "intake"],
      "properties": {
        "critical_check": { "type": "string", "description": "Checked FIRST by the judge, from the observation plane (not host self-report): no host left on an eval binary, no agent down." },
        "intake": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serialized", "automatic_rollback", "watchdog_required", "min_soak_seconds"],
          "properties": {
            "serialized": { "type": "boolean" },
            "automatic_rollback": { "type": "boolean" },
            "watchdog_required": { "type": "boolean" },
            "min_soak_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "keyless_build_hosts": { "type": "boolean" },
        "excluded_hosts_policy": { "type": "string" }
      }
    }
  }
}
